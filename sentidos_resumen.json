import json

with open(
    "vehiculos_sentido.json",
    encoding="utf-8"
) as f:

    vehiculos = json.load(f)

resultado = {}

for tren in vehiculos:

    linea = tren.get("linea")

    if not linea:
        continue

    origen = tren.get(
        "origen_viaje"
    )

    destino = tren.get(
        "destino_viaje"
    )

    if linea not in resultado:

        resultado[linea] = {
            "ida": [],
            "vuelta": []
        }

    sentido = "ida"

    if origen and destino:

        if origen > destino:
            sentido = "vuelta"

    resultado[linea][sentido].append({

        "trip_id":
            tren["trip_id"],

        "origen_viaje":
            origen,

        "destino_viaje":
            destino,

        "proxima_estacion":
            tren.get(
                "proxima_estacion"
            )

    })

with open(
    "sentidos_linea.json",
    "w",
    encoding="utf-8"
) as f:

    json.dump(
        resultado,
        f,
        ensure_ascii=False,
        indent=2
    )

print(
    f"{len(resultado)} líneas generadas"
)
